# You have to create TEAM ADMIN api key to be able to use new CLI commands for integrations and edgehancers management
UNIFORM_API_KEY=

# Your team ID to use for Uniform CLI. Be aware if you are going to deploy/remove edgehancers, you need to have the right entitlements for your team
UNIFORM_TEAM_ID=

# Can be used to install/uninstall your custom integration in particular project
UNIFORM_PROJECT_ID=

UNIFORM_CLI_BASE_URL=

UNIFORM_CLI_BASE_EDGE_URL=

# --- MCP App OAuth bridge ---

# Required in production. 32+ random characters, e.g. `openssl rand -base64 32`.
# Keys the sealed envelopes the bridge issues (client ids, authorization codes,
# access and refresh tokens). Changing it invalidates every issued token.
MCP_BRIDGE_SECRET=

# Optional. Pins the bridge's own Contentful OAuth client instead of registering
# a new one per cold start via dynamic client registration. Its redirect_uri
# must be <deployment origin>/oauth/callback.
CONTENTFUL_OAUTH_CLIENT_ID=
